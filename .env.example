# ==========================================
# Supabase (required)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# Discord webhooks (required)
# ==========================================
MARKET_DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...
STATUS_DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...

# ==========================================
# ML Discord output (optional)
# ==========================================
# Leave blank to disable ML overlay Discord posting
ML_DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...

# ==========================================
# Dhan API credentials
# ==========================================
# NOT read from env — see src/aeolus/ingestion/credentials.py
# Loaded at runtime from Supabase `api_keys` table (provider=DHAN)
